server:
  host: "0.0.0.0"
  port: 8080
  read_timeout: 30s
  write_timeout: 0
  idle_timeout: 120s
  max_header_bytes: 1048576

wetransfer:
  user_agent: "Mozilla/5.0 (compatible; ProxyDownloader/1.0)"
  request_timeout: 30s
  max_redirects: 10

audit:
  db_path: "data/audit.db"
  retention_days: 90
  access_log_dir: "data/logs"
  access_log_retention_days: 7
  hash_downloads: true
  max_hash_size_mb: 500
  off_hours_start: 22
  off_hours_end: 6
  bulk_download_count: 10
  bulk_download_window_minutes: 5
  anomaly_max_file_size_gb: 10

limits:
  max_concurrent_downloads: 50
  max_file_size_gb: 2
  rate_limit_per_minute: 30

logging:
  level: "info"
  format: "json"

ui:
  enabled: true
  title: "WeBridge"
  max_url_length: 2048

auth:
  session_ttl: 24h
  login_rate_limit:
    max_attempts: 5
    window_minutes: 15
    backoff_base_minutes: 1
    backoff_max_minutes: 64
  users:
    - username: "admin"
      password: "admin123"   # CHANGE THIS
      role: "admin"
    - username: "user"
      password: "user123"    # CHANGE THIS
      role: "user"

# LDAP / SSO: unknown usernames are authenticated against this directory on login,
# then auto-added to Local Users (source: ldap) so you can assign groups/roles.
# ldap:
#   enabled: true
#   host: "ad.example.com"
#   port: 636                  # 636 = LDAPS, 389 = LDAP (+ starttls below)
#   starttls: false            # upgrade plain 389 connections to TLS
#   insecure_skip_verify: false
#   bind_dn: "cn=svc-pd,dc=example,dc=com"   # "" for anonymous search
#   bind_password: "secret"
#   base_dn: "ou=people,dc=example,dc=com"
#   user_filter: "(uid=%s)"    # Active Directory: "(sAMAccountName=%s)"
#   default_groups: ["users"]  # local groups auto-assigned on first login