server:
  host: "0.0.0.0"
  port: 8080
  read_timeout: 30s
  write_timeout: 0
  idle_timeout: 120s
  max_header_bytes: 1048576

wetransfer:
  request_timeout: 30s
  max_redirects: 10

audit:
  db_path: "/app/config/data/audit.db"
  retention_days: 90
  access_log_dir: "/app/config/data/logs"

limits:
  max_concurrent_downloads: 50
  max_file_size_gb: 2
  rate_limit_per_minute: 30

logging:
  level: "info"
  format: "json"

ui:
  enabled: true
  title: "WeBridge"
  max_url_length: 2048

auth:
  session_ttl: 24h
  login_rate_limit:
    max_attempts: 5
    window_minutes: 15
    backoff_base_minutes: 1
    backoff_max_minutes: 64
  users:
    - username: "admin"
      password: "admin123"   # CHANGE THIS
      role: "admin"
    - username: "user"
      password: "user123"    # CHANGE THIS
      role: "user"

# LDAP / SSO: unknown usernames are authenticated against this directory on login,
# then auto-added to Local Users (source: ldap) so you can assign groups/roles.
# ldap:
#   enabled: true
#   host: "ad.example.com"
#   port: 636                  # 636 = LDAPS, 389 = LDAP (+ starttls below)
#   starttls: false            # upgrade plain 389 connections to TLS
#   insecure_skip_verify: false
#   bind_dn: "cn=svc-pd,dc=example,dc=com"   # "" for anonymous search
#   bind_password: "secret"
#   base_dn: "ou=people,dc=example,dc=com"
#   user_filter: "(uid=%s)"    # Active Directory: "(sAMAccountName=%s)"
#   default_groups: ["users"]  # local groups auto-assigned on first login

# imap: email sign-in — users can log in with their org email address;
# credentials are verified against the IMAP server, never stored locally.
# Runtime-editable from Settings (persisted to imap-settings.json).
# imap:
#   enabled: true
#   host: "mail.example.com"
#   port: 993                  # 993 = TLS (default), 143 + starttls below
#   starttls: false            # upgrade plain 143 connections to TLS
#   insecure_skip_verify: false
#   allowed_domains: ["example.com"]  # only these email domains may sign in
#   auto_provision: true       # create account on first successful login
#   default_groups: ["users"]  # groups for auto-created accounts